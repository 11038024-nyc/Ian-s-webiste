
:root {
  --bg: #f7f9fc;
  --surface: #ffffff;
  --surface-muted: #f0f4f8;
  --text: #111827;
  --text-soft: #5f6b7a;
  --line: #dbe2ea;
  --navy: #0b1220;
  --navy-soft: #172033;
  --blue: #1f5eff;
  --blue-dark: #1748c9;
  --blue-soft: #eaf0ff;
  --white: #ffffff;
  --radius-lg: 26px;
  --radius-md: 18px;
  --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

img,
svg {
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.container {
  width: min(1140px, calc(100% - 40px));
  margin: 0 auto;
}

.skip-link {
  position: absolute;
  left: -999px;
  top: 0;
  z-index: 100;
  padding: 12px 18px;
  background: var(--navy);
  color: white;
}

.skip-link:focus {
  left: 12px;
  top: 12px;
}

/* Header */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(219, 226, 234, 0.9);
  background: rgba(247, 249, 252, 0.92);
  backdrop-filter: blur(16px);
}

.nav-shell {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  font-weight: 700;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--navy);
  color: white;
  font-family: "Manrope", sans-serif;
  font-size: 0.9rem;
  letter-spacing: -0.02em;
}

.brand-name {
  font-family: "Manrope", sans-serif;
  font-size: 0.98rem;
}

nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

nav a {
  color: var(--text-soft);
  font-size: 0.9rem;
  font-weight: 600;
}

nav a:hover,
nav a:focus-visible {
  color: var(--text);
}

.nav-contact {
  padding: 10px 15px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  color: var(--text);
}

.menu-button {
  display: none;
  border: 0;
  background: transparent;
  padding: 7px;
}

.menu-button span {
  width: 23px;
  height: 2px;
  display: block;
  margin: 5px 0;
  background: var(--text);
  border-radius: 999px;
}

/* Hero */

.hero {
  padding: 108px 0 92px;
}

.hero-layout {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 70px;
  align-items: center;
}

.eyebrow,
.section-label,
.profile-kicker,
.card-label,
.skill-title,
.meta-label {
  margin: 0;
  color: var(--blue);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 16px 0 22px;
  max-width: 800px;
  font-family: "Manrope", sans-serif;
  font-size: clamp(3.2rem, 7vw, 6.6rem);
  line-height: 0.97;
  letter-spacing: -0.065em;
}

.hero h1 span {
  display: block;
  color: var(--blue);
}

.hero-copy {
  max-width: 760px;
  margin: 0;
  color: var(--text-soft);
  font-size: 1.12rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 32px 0 38px;
}

.button {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  border-radius: 13px;
  font-weight: 700;
  font-size: 0.93rem;
  transition: transform 180ms ease, background 180ms ease, border 180ms ease;
}

.button:hover,
.button:focus-visible {
  transform: translateY(-1px);
}

.button-primary {
  background: var(--blue);
  color: white;
}

.button-primary:hover {
  background: var(--blue-dark);
}

.button-secondary {
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--text);
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  max-width: 760px;
}

.hero-meta div {
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.hero-meta strong {
  display: block;
  margin-top: 4px;
  font-size: 0.92rem;
}

/* Profile panel */

.profile-panel {
  padding: 30px;
  border: 1px solid #1f2a3f;
  border-radius: 30px;
  background:
    radial-gradient(circle at top right, rgba(31, 94, 255, 0.25), transparent 32%),
    var(--navy);
  color: white;
  box-shadow: var(--shadow);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 14px;
}

.profile-avatar {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  background: white;
  color: var(--navy);
  font-family: "Manrope", sans-serif;
  font-weight: 800;
}

.profile-status {
  margin: 0 0 2px;
  font-weight: 700;
}

.profile-location {
  margin: 0;
  color: #9fa9bc;
  font-size: 0.86rem;
}

.profile-section {
  margin-top: 34px;
}

.profile-kicker {
  color: #8eb0ff;
}

.profile-section h2 {
  margin: 9px 0 0;
  font-family: "Manrope", sans-serif;
  font-size: 1.55rem;
  line-height: 1.28;
  letter-spacing: -0.03em;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 22px;
}

.profile-tags span {
  padding: 7px 10px;
  border: 1px solid #2a3650;
  border-radius: 999px;
  background: #111a2b;
  color: #d5dbea;
  font-size: 0.78rem;
  font-weight: 600;
}

.profile-divider {
  height: 1px;
  margin: 28px 0;
  background: #27334a;
}

.profile-credential {
  display: grid;
  gap: 3px;
}

.profile-credential span {
  color: #8eb0ff;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.profile-credential strong {
  font-size: 0.95rem;
}

.profile-credential small {
  color: #9fa9bc;
}

/* Shared sections */

.section {
  padding: 92px 0;
}

.section-muted {
  background: var(--surface-muted);
}

.section-dark {
  background: var(--navy);
  color: white;
}

.section-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 86px;
  align-items: start;
}

.section-intro h2,
.section-heading h2,
.contact-shell h2 {
  margin: 10px 0 0;
  max-width: 760px;
  font-family: "Manrope", sans-serif;
  font-size: clamp(2.2rem, 4vw, 4rem);
  line-height: 1.08;
  letter-spacing: -0.05em;
}

.section-body {
  color: var(--text-soft);
  font-size: 1.02rem;
}

.section-body .lead {
  color: var(--text);
  font-size: 1.12rem;
  font-weight: 500;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  align-items: end;
  margin-bottom: 36px;
}

.section-heading > p {
  max-width: 420px;
  margin: 0 0 4px;
  color: var(--text-soft);
}

.section-heading-dark > p {
  color: #aab4c5;
}

/* Experience */

.experience-list {
  display: grid;
  gap: 18px;
}

.experience-card {
  display: grid;
  grid-template-columns: 190px 1fr;
  gap: 34px;
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.experience-sidebar {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.experience-type {
  color: var(--blue);
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
}

.experience-org {
  color: var(--text-soft);
  font-size: 0.88rem;
}

.experience-content h3 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: 1.45rem;
}

.experience-content > p,
.role-summary {
  margin: 4px 0 0;
  color: var(--text-soft);
}

.experience-content ul {
  margin: 20px 0 0;
  padding-left: 20px;
  color: var(--text-soft);
}

.experience-content li + li {
  margin-top: 8px;
}

/* Education */

.education-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.education-card {
  min-height: 100%;
  display: grid;
  gap: 22px;
  padding: 26px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.card-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 0.8rem;
  font-weight: 800;
}

.education-card h3 {
  margin: 5px 0 2px;
  font-family: "Manrope", sans-serif;
  font-size: 1.3rem;
}

.card-subtitle {
  margin: 0;
  color: var(--blue);
  font-weight: 700;
  font-size: 0.9rem;
}

.education-card p:last-child {
  color: var(--text-soft);
}

/* Skills */

.skills-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 0.85fr;
  gap: 36px;
}

.skill-group {
  padding: 26px;
  border: 1px solid #26334b;
  border-radius: var(--radius-lg);
  background: var(--navy-soft);
}

.skill-title {
  color: #8eb0ff;
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
}

.skill-list span {
  padding: 8px 10px;
  border: 1px solid #33415c;
  border-radius: 999px;
  color: #d8deea;
  font-size: 0.82rem;
  font-weight: 600;
}

.language-list {
  margin-top: 15px;
}

.language-list div {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding: 11px 0;
  border-bottom: 1px solid #2a3650;
}

.language-list span {
  font-weight: 600;
}

.language-list small {
  color: #9fa9bc;
}

/* Projects */

.projects-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr 1fr;
  gap: 18px;
}

.project-card {
  padding: 26px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.project-featured {
  background: var(--navy);
  border-color: var(--navy);
  color: white;
}

.project-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--text-soft);
  font-size: 0.73rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.project-featured .project-meta {
  color: #99a5bb;
}

.project-card h3 {
  margin: 20px 0 10px;
  font-family: "Manrope", sans-serif;
  font-size: 1.45rem;
}

.project-card p {
  color: var(--text-soft);
}

.project-featured p {
  color: #bdc5d4;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}

.project-tags span {
  padding: 6px 9px;
  border: 1px solid #33415c;
  border-radius: 999px;
  color: #d9dfeb;
  font-size: 0.76rem;
  font-weight: 600;
}

/* Contact */

.contact-section {
  padding-top: 68px;
}

.contact-shell {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 42px;
  align-items: center;
  padding: 42px;
  border: 1px solid var(--line);
  border-radius: 30px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.contact-shell p {
  max-width: 700px;
  color: var(--text-soft);
}

.contact-actions {
  display: grid;
  gap: 10px;
}

.contact-link {
  margin-top: 8px;
  text-align: center;
  color: var(--blue);
  font-weight: 700;
  font-size: 0.92rem;
}

/* Footer */

footer {
  padding: 34px 0 46px;
}

.footer-row {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  color: var(--text-soft);
  font-size: 0.86rem;
}

/* Responsive */

@media (max-width: 920px) {
  .hero-layout,
  .section-grid,
  .contact-shell {
    grid-template-columns: 1fr;
  }

  .hero-layout {
    gap: 48px;
  }

  .profile-panel {
    max-width: 680px;
  }

  .education-grid,
  .skills-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .section-heading {
    display: block;
  }

  .section-heading > p {
    margin-top: 18px;
  }

  .experience-card {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .experience-sidebar {
    flex-direction: row;
    justify-content: space-between;
  }
}

@media (max-width: 760px) {
  .menu-button {
    display: block;
  }

  nav {
    display: none;
    position: absolute;
    left: 20px;
    right: 20px;
    top: 68px;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  nav.open {
    display: flex;
  }

  nav a {
    padding: 10px 12px;
  }

  .nav-contact {
    text-align: center;
  }

  .brand-name {
    display: none;
  }

  .hero {
    padding: 78px 0 72px;
  }

  .hero-meta {
    grid-template-columns: 1fr;
  }

  .hero-meta div {
    display: flex;
    justify-content: space-between;
    gap: 18px;
  }

  .section {
    padding: 72px 0;
  }

  .section-grid {
    gap: 38px;
  }
}

@media (max-width: 560px) {
  .container {
    width: min(100% - 28px, 1140px);
  }

  .hero h1 {
    font-size: 3.25rem;
  }

  .hero-actions {
    display: grid;
  }

  .button {
    width: 100%;
  }

  .profile-panel,
  .experience-card,
  .education-card,
  .project-card,
  .skill-group,
  .contact-shell {
    border-radius: 20px;
  }

  .contact-shell {
    padding: 28px;
  }

  .footer-row {
    display: grid;
    gap: 4px;
  }
}
